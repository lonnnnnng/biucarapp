<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- long: 账号 Cookie、播放历史和本地音频缓存不进入云备份或设备迁移，避免凭据和车机媒体状态跨设备泄漏。 -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
